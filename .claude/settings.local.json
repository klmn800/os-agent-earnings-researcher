{
  "permissions": {
    "allow": [
      "Bash(python E:/options_scanner/tools/earnings_confirm.py *)",
      "Bash(python E:/options_scanner/tools/direct_db_query.py *)",
      "WebSearch",
      "WebFetch",
      "Read(//e/options_scanner/**)",
      "Bash(python tools/direct_db_query.py --db data/datalake.db --write --sql \"UPDATE earnings_upcoming SET date_confirmed=0, date_confirmed_by=NULL WHERE symbol='WHR'\")",
      "Bash(python tools/earnings_confirm.py --symbol CPRT --date 2026-09-10 --time amc --by agent)",
      "Bash(python tools/earnings_confirm.py --symbol GIS --date 2026-09-23 --time bmo --by agent)"
    ],
    "deny": [
      "Bash(sqlite3 *)",
      "Bash(python E:/options_scanner/main.py *)",
      "Bash(rm *)",
      "Bash(del *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python E:/options_scanner/agents/earnings_researcher/hooks/inject_context.py",
            "timeout": 15000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python E:/options_scanner/.claude/hooks/earnings_researcher_write_guard.py",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": [
    "E:/options_scanner/CLAUDE.md"
  ]
}
